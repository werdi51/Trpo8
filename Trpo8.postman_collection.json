{
  "info": {
    "name": "Trpo8 API (JWT)",
    "description": "Коллекция для проверки практической работы №8. Сначала выполните запрос 1 (логин) — токен сохранится в переменную token и подставится во все остальные запросы автоматически.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7171"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Логин admin123 (получить токен)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.access_token) {",
              "    pm.collectionVariables.set('token', data.access_token);",
              "    console.log('Токен сохранён в переменную token');",
              "} else {",
              "    console.log('В ответе нет access_token');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"admin123\",\n  \"password\": \"P@s$w0rd\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "2. Создать задачу",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.id) {",
              "    pm.collectionVariables.set('taskId', data.id);",
              "    console.log('id задачи сохранён в переменную taskId: ' + data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"работа\",\n  \"description\": \"тяжелая\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/tasks"
      }
    },
    {
      "name": "3. Мои задачи",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks"
      }
    },
    {
      "name": "4. Все задачи (только Admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks/all"
      }
    },
    {
      "name": "5. Задача по id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    },
    {
      "name": "6. Изменить задачу (isCompleted: true)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"работа\",\n  \"description\": \"тяжелая\",\n  \"isCompleted\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    },
    {
      "name": "7. Изменить без isCompleted (статус не сбросится)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"работа (переименована)\",\n  \"description\": \"тяжелая\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    },
    {
      "name": "8. Удалить задачу",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    },
    {
      "name": "9. Без токена (ожидается 401)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks"
      }
    }
  ]
}
